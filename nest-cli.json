{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ],
    "assets": [
      {
        "include": "modules/guests/infrastructure/fonts/**/*",
        "outDir": "dist"
      },
      {
        "include": "modules/site/domain/appearance-contrast.fixture.json",
        "outDir": "dist"
      }
    ]
  }
}
