# Ambiente dos testes e2e: banco kore_test no mesmo Postgres do docker compose.
# Credenciais só locais, sem valor real.
APP_ENV=test
DATABASE_URL=postgresql://kore_api:kore_api@localhost:5433/kore_test
# Backoffice e rotinas: entra como kore_backoffice (BYPASSRLS).
DATABASE_BACKOFFICE_URL=postgresql://kore_routines:kore_routines@localhost:5433/kore_test
DATABASE_MIGRATION_URL=postgresql://kore:kore@localhost:5433/kore_test
REDIS_URL=redis://localhost:6380
ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
# Limite geral alto: as suítes e2e somam requisições do mesmo IP no mesmo minuto.
RATE_LIMIT_GENERAL_PER_MINUTE=1000
TRUST_PROXY_HOPS=1
EMAIL_PROVIDER=smtp
EMAIL_FROM="Kore <nao-responda@kore.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
# Só dos testes: API do Mailpit para conferir o e-mail entregue.
MAILPIT_API_URL=http://localhost:8025
KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=vcBUQBUai0XFOnFtkrRQ02rgakBNyimR24jmhWdcVMU=
OTEL_EXPORTER=none
LOG_LEVEL=silent
