# Ambiente: local | test | homolog | production
APP_ENV=local
PORT=3000

# A API conecta com kore_api (membro de kore_app, sujeito à RLS).
DATABASE_URL=postgresql://kore_api:kore_api@localhost:5433/kore
# Migrations e criação dos usuários locais rodam com o dono do schema.
DATABASE_MIGRATION_URL=postgresql://kore:kore@localhost:5433/kore
