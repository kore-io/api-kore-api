# Ambiente: local | test | homolog | production
APP_ENV=local
PORT=3000

# A API conecta com kore_api (membro de kore_app, sujeito à RLS).
DATABASE_URL=postgresql://kore_api:kore_api@localhost:5433/kore
# Backoffice e rotinas: entra como kore_backoffice (BYPASSRLS).
DATABASE_BACKOFFICE_URL=postgresql://kore_routines:kore_routines@localhost:5433/kore
# Migrations e criação dos usuários locais rodam com o dono do schema.
DATABASE_MIGRATION_URL=postgresql://kore:kore@localhost:5433/kore

REDIS_URL=redis://localhost:6380

# Origens do app que chamam a API com o cookie de sessão (separadas por vírgula).
ALLOWED_ORIGINS=http://localhost:5173
# Endereço do app, para os links dos e-mails.
APP_URL=http://localhost:5173
# Site do casal, em porta própria no local (decisão 207, item 12): base do link do
# grupo, <SITE_URL>/<slug>/grupo/<token> (decisão 196), e a origem das rotas do site.
SITE_URL=http://localhost:5174

# Rate limit por IP, por minuto, e proxies confiáveis na frente da API.
RATE_LIMIT_GENERAL_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10
TRUST_PROXY_HOPS=0

# E-mail aos usuários: SMTP do Mailpit no local (web em http://localhost:8025).
EMAIL_PROVIDER=smtp
EMAIL_FROM="Kore <nao-responda@kore.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# Criptografia de envelope: chave mestra de desenvolvimento (32 bytes em base64).
# Só aceita com APP_ENV local ou test. Gere outra com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=258+JWcuRfDrsS0xeKuTKgRV7p+kFlSMaIu3PErymmo=

# Observabilidade: traces no console (local) ou none; nível do log do pino.
OTEL_EXPORTER=console
LOG_LEVEL=info

# Chave do HMAC do IP no log da aplicação (32 bytes em base64).
IP_HASH_KEY=y23SHU7SsFQYQZEEX9Pdr9F/FoCILgoWhQHBAAS44gc=

# Chave do HMAC do casamento nos eventos de produto (32 bytes em base64).
PRODUCT_EVENT_KEY=XzCeByXDR3XJNoRpPJNl4XyRC7WMhdK1MF7T2llEXOk=

# Chave do HMAC do código de login (32 bytes em base64).
LOGIN_CODE_KEY=AMUIAxq32RpneQW5IM0YNjUxG4zz+Z+GxGdUeEj0Rmc=

# Login pelo Google: dev (local e test, sem credencial) ou google (cliente OIDC).
GOOGLE_PROVIDER=dev
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
# Chave do HMAC do cookie do state e do PKCE do Google (32 bytes em base64).
OAUTH_STATE_KEY=nKTxWhY4lzQ+sR037TnEfHcScVZXA1kcFbG/ODTNFik=

# Versão vigente dos Termos e da Política: o cadastro só aceita esta (decisão 166).
TERMS_VERSION=2026-09

# Armazenamento (Imagens do site): MinIO do docker compose, console em http://localhost:9001.
# Os buckets são criados por "pnpm storage:setup". Credenciais só locais (ADR do MinIO).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=kore
STORAGE_SECRET_ACCESS_KEY=kore-minio-local
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRIVATE_BUCKET=kore-private
STORAGE_PUBLIC_BUCKET=kore-public
STORAGE_PUBLIC_URL=http://localhost:9000/kore-public

# Chave do HMAC do cookie do grupo do site, kore_party_<weddingId> (32 bytes em base64).
PARTY_COOKIE_KEY=gGXUHiAkgObPVjMgOTTQoB8bQ2x3bAQZFsT8iEVuL1s=
# Chave do HMAC do cookie da prévia do site, kore_site_preview_<weddingId> (32 bytes em base64).
PREVIEW_COOKIE_KEY=yp9yf0h27kwoB74dtyyS98gOmPe19wQSab4jQoEbL5c=

# Simulador do site (Simule RN01): sem a variável, ligado só em local e test.
# SIMULATOR_ENABLED=true

# Publicação por Cortesia (Publicação RN01): sem valor, desligada. Só pode ser
# ligada em local e test; com APP_ENV homolog ou production ligada, a API não sobe.
COURTESY_PUBLICATION_ENABLED=true
